<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Core is {CoreVersion}.0 and ports are {CoreVersion}.{PortIteration}; the publish workflows pass both in from the latest v* tag -->
  <PropertyGroup>
    <CoreVersion Condition="'$(CoreVersion)' == ''">0.0</CoreVersion>
    <PortIteration Condition="'$(PortIteration)' == ''">0</PortIteration>
    <Version>$(CoreVersion).0</Version>
  </PropertyGroup>

  <!-- NuGet package metadata shared by all DDCSharp packages -->
  <PropertyGroup>
    <Authors>Laurynas Gailius</Authors>
    <Product>DDCSharp</Product>
    <RepositoryUrl>https://github.com/LorryGailius/DDCSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/LorryGailius/DDCSharp</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
