<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>$(CoreVersion).$(PortIteration)</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>DDCSharp.Windows</PackageId>
    <Description>Windows implementation for DDCSharp providing monitor enumeration and VCP command transport.</Description>
    <PackageTags>DDC;DDC/CI;Monitor;Display;VCP;Windows</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DDCSharp.Core\DDCSharp.Core.csproj" />
  </ItemGroup>

</Project>
